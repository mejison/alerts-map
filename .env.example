# Server-only secrets; never use NEXT_PUBLIC_ for these values.
ALERT_PROVIDER=neptun
# ALERT_PROVIDER=alerts-in-ua
ALERTS_IN_UA_TOKEN=
# ALERT_PROVIDER=ukrainealarm
UKRAINE_ALARM_TOKEN=

# Netlify Functions only. Generate once with npm run push:keys.
# Store the private key in Netlify environment variables (Functions scope).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Public HTTPS site URL or mailto: contact address, not localhost.
VAPID_SUBJECT=
